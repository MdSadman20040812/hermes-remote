<?xml version="1.0" encoding="utf-8"?>
<!--
    Notification small icon: the same mark at tray scale.

    Android renders these as a flat alpha mask, so this is deliberately white
    on transparent with no fill detail — any colour or gradient here would be
    discarded, and thin strokes would disappear. Strokes are proportionally
    heavier than the launcher mark because 24dp is where hairlines die.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

    <path
        android:pathData="M4,18 L12.5,9.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round" />
    <path
        android:pathData="M9,18 L15.5,11.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round" />
    <path
        android:pathData="M14,18 L18.5,13.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round" />
</vector>
