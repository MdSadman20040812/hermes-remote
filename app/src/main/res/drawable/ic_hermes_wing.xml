<?xml version="1.0" encoding="utf-8"?>
<!--
    The Hermes mark: three swept feathers, the winged-messenger idea reduced to
    the one thing it has to say at 24dp — motion, in a direction.

    Drawn as stroked diagonals rather than filled shapes so the same geometry
    scales from the notification tray to the adaptive icon without a second
    asset, and stays legible when the system tints it flat white.

    Artwork sits inside x/y 26..82 of the 108dp viewport, which is the adaptive
    icon's safe zone — anything outside that gets cropped by a circular mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M28,76 L62,42"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="10"
        android:strokeLineCap="round" />
    <path
        android:pathData="M44,76 L72,48"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="10"
        android:strokeLineCap="round" />
    <path
        android:pathData="M60,76 L80,56"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="10"
        android:strokeLineCap="round" />
</vector>
