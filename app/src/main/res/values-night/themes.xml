<resources>
    <!--
        Dark is the scheme this app is designed around, so the window it opens
        into has to already be dark. Without this the first frame of every cold
        start is a white flash before Compose paints — the single most obvious
        tell that a dark app is not really dark.
    -->
    <style name="Theme.HermesMobile" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/hermes_deep</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.HermesMobile.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/hermes_deep</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.HermesMobile</item>
    </style>
</resources>
